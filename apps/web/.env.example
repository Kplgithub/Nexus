# ─── NEXUS web — copy to apps/web/.env.local for development ───

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Next.js server reaches the API (server-side only; never exposed to browsers).
# Docker: http://api:4000   Same host with PM2: http://127.0.0.1:4000
API_INTERNAL_URL=http://localhost:4000

# Optional extra HTTPS image hosts, comma separated (e.g. an S3 bucket domain).
IMAGE_HOSTS=

# Seconds public pages may be cached before refetching listing data.
REVALIDATE_SECONDS=60

# Set to "true" on staging so search engines never index it.
NEXT_PUBLIC_NOINDEX=false

# Google Tag Manager container (defaults to the NEXUS container GTM-TDXSXMSM). Set empty to turn off.
# NEXT_PUBLIC_GTM_ID=GTM-TDXSXMSM
# Google Analytics 4, loaded directly (defaults to G-4CWB09V7NM). Set empty to turn off.
# Do not also add this GA4 ID as a tag inside GTM, or pageviews count twice.
# NEXT_PUBLIC_GA_ID=G-4CWB09V7NM
