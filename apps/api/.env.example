# ─── NEXUS API — copy to apps/api/.env for local development ───
# Never commit real values. In production set these in the server's env file
# (see docs/DEPLOYMENT.md) or your host's secret manager.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/nexus
# Production: MongoDB Atlas SRV string with a dedicated, least-privilege user.
MONGODB_URI=mongodb://127.0.0.1:27017/nexus

# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Number of reverse proxies in front of the API (1 behind Nginx).
TRUST_PROXY=0

# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Uploads: "local" for development, "cloudinary" required in production.
UPLOAD_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
LOCAL_UPLOAD_PUBLIC_URL=http://localhost:4000/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nexus-estate/properties

# Optional email alerts for new leads. Recipient is set in Admin → Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NEXUS Estate <no-reply@example.com>"

# Optional AI images (Admin → Settings → "Generate with AI" for the home hero).
# Off unless BOTH keys are set. Claude writes the prompt, OpenAI renders the image,
# and it is stored through the normal upload path (Cloudinary in production).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROMPT_MODEL=claude-sonnet-5-5
AI_IMAGE_MODEL=gpt-image-1
# low | medium | high — higher costs more per image
AI_IMAGE_QUALITY=medium
# AI_BRAND_STYLE="premium real-estate photography, warm golden-hour light, calm and uncluttered"

ENABLE_API_DOCS=true
PUBLIC_CACHE_SECONDS=60
