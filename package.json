{
  "name": "nexus-estate",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS Estate | Rentals | Properties — real estate rental platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter @nexus/shared build && pnpm -r --filter @nexus/api --filter @nexus/web build",
    "dev": "pnpm --filter @nexus/shared build && pnpm -r --parallel --filter @nexus/api --filter @nexus/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @nexus/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @nexus/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @nexus/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:admin": "pnpm --filter @nexus/api seed:admin",
    "seed:base": "pnpm --filter @nexus/api seed:base",
    "seed:demo": "pnpm --filter @nexus/api seed:demo",
    "demo:remove": "pnpm --filter @nexus/api demo:remove"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "typescript": "^5.9.0"
  }
}
