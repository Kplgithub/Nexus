# Copy to deploy/.env.production ON THE SERVER ONLY (chmod 600). Never commit it.
# Every value marked <...> must be replaced.

RELEASE=latest
NEXT_PUBLIC_SITE_URL=https://<your-domain>
NEXT_PUBLIC_NOINDEX=false
REVALIDATE_SECONDS=60
IMAGE_HOSTS=

# ---- API ----
LOG_LEVEL=info
MONGODB_URI=<mongodb+srv://nexus_app:<password>@<cluster>/nexus?retryWrites=true&w=majority>
CORS_ORIGINS=https://<your-domain>,https://www.<your-domain>
PUBLIC_SITE_URL=https://<your-domain>
JWT_SECRET=<output of: openssl rand -base64 48>
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# Website user accounts. Mobile OTP needs an MSG91 account with a DLT-approved OTP template.
# Leave SMS_DRIVER=disabled until then (users sign in with email + password).
USER_SESSION_TTL_DAYS=30
SMS_DRIVER=disabled
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

UPLOAD_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_FOLDER=nexus-estate/properties

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

ENABLE_API_DOCS=false
PUBLIC_CACHE_SECONDS=60
